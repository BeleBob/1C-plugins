// Массовое переименование номенклатуры - клиентская часть.
// Общий модуль расширения. Свойства: Клиент (управляемое приложение) = Истина.

#Область Настройки

// Имя компьютера, на котором работают команды (то, что выводит команда hostname в Windows).
// Пустая строка - на любом компьютере.
Функция РазрешенныйКомпьютер()
	Возврат "";
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Переименовывает выделенные в форме позиции в текст из буфера обмена.
Асинх Процедура ПереименоватьИзБуфера(Форма) Экспорт

	Если Не МожноВыполнить(Форма) Тогда
		Возврат;
	КонецЕсли;

	Ссылки = ВыделеннаяНоменклатура(Форма);
	Если Ссылки.Количество() = 0 Тогда
		ПоказатьОшибку("Не выделено ни одной позиции номенклатуры.");
		Возврат;
	КонецЕсли;

	Попытка
		ТекстБуфера = Ждать ТекстИзБуфера();
	Исключение
		ПоказатьОшибку("Не удалось прочитать буфер обмена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	Если ТекстБуфера = Неопределено Тогда
		ПоказатьОшибку("В буфере обмена нет текста.");
		Возврат;
	КонецЕсли;

	НовоеНаименование = ОднаСтрока(ТекстБуфера);
	Если НовоеНаименование = Неопределено Тогда
		ПоказатьОшибку("В буфере обмена несколько строк или таблица - нужна одна строка.");
		Возврат;
	КонецЕсли;

	Попытка
		Результат = МП_ПереименованиеВызовСервера.Переименовать(Ссылки, НовоеНаименование);
	Исключение
		ПоказатьОшибку(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ОповеститьОбИзменении(Тип("СправочникСсылка.Номенклатура"));
	ПоказатьОповещениеПользователя(СтрШаблон("Переименовано: %1", Результат.Переименовано), ,
		"→ " + НовоеНаименование);
	СообщитьПропущенные(Результат.Пропущено);

КонецПроцедуры

// Откатывает последнее переименование.
Процедура Откатить(Форма) Экспорт

	Если Не МожноВыполнить(Форма) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Результат = МП_ПереименованиеВызовСервера.Откатить();
	Исключение
		ПоказатьОшибку(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Результат.ИсторияПуста Тогда
		ПоказатьОповещениеПользователя("Откатывать нечего");
		Возврат;
	КонецЕсли;

	ОповеститьОбИзменении(Тип("СправочникСсылка.Номенклатура"));
	ПоказатьОповещениеПользователя(СтрШаблон("Откат: восстановлено %1", Результат.Восстановлено), ,
		СтрШаблон("Можно откатить еще: %1", Результат.ОсталосьОпераций));
	СообщитьПропущенные(Результат.Пропущено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МожноВыполнить(Форма)

	Компьютер = РазрешенныйКомпьютер();
	Если ЗначениеЗаполнено(Компьютер) И ВРег(ИмяКомпьютера()) <> ВРег(Компьютер) Тогда
		ПоказатьОшибку("Массовое переименование недоступно на этом компьютере.");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ВыделеннаяНоменклатура(Форма)

	Ссылки = Новый Массив;

	// Курсор может стоять в поле поиска - тогда берем выделение из основного списка.
	Если ТипЗнч(Форма.ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
		Таблица = Форма.ТекущийЭлемент;
	Иначе
		Таблица = Форма.Элементы.Найти("Список");
	КонецЕсли;
	Если Таблица = Неопределено Тогда
		Возврат Ссылки;
	КонецЕсли;

	ТипНоменклатуры = Тип("СправочникСсылка.Номенклатура");
	Для Каждого Строка Из Таблица.ВыделенныеСтроки Цикл
		Если ТипЗнч(Строка) = ТипНоменклатуры Тогда
			Ссылки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;

	Возврат Ссылки;

КонецФункции

// Возвращает текст из буфера обмена или Неопределено (платформа 8.3.24+).
Асинх Функция ТекстИзБуфера()

	Если Не СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Формат = СтандартныйФорматДанныхБуфераОбмена.Текст;
	Если Не Ждать СредстваБуфераОбмена.СодержитДанныеАсинх(Формат) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Текст = Ждать СредстваБуфераОбмена.ПолучитьДанныеАсинх(Формат);
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Текст;

КонецФункции

// Возвращает единственную непустую строку текста без крайних пробелов.
// Если строк несколько или есть табуляция (скопирована таблица) - Неопределено.
Функция ОднаСтрока(Текст)

	Строки = Новый Массив;
	Для Каждого Строка Из СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Строка)) Тогда
			Строки.Добавить(СокрЛП(Строка));
		КонецЕсли;
	КонецЦикла;

	Если Строки.Количество() <> 1 Или СтрНайти(Строки[0], Символы.Таб) > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Строки[0];

КонецФункции

Процедура ПоказатьОшибку(Текст)

	ПоказатьОповещениеПользователя("Не переименовано", , Текст);
	Сообщить(Текст);

КонецПроцедуры

Процедура СообщитьПропущенные(Пропущено)

	Для Каждого Текст Из Пропущено Цикл
		Сообщить(Текст);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
