// Поиск двойников у номенклатуры с отрицательным остатком и их объединение.
// Общий модуль расширения. Свойства: Сервер = Истина, Вызов сервера = Истина.
// Данные меняют только ОбъединитьГруппу (автообъединение, только администратор) и ОбъединитьИзОчереди:
// через штатную замену ссылок БСП ОбщегоНазначения.ЗаменитьСсылки с пометкой на удаление.
// Очередь объединения хранится в настройках пользователя (ХранилищеОбщихНастроек).

#Область Настройки

// Кому доступна команда, кроме полноправных пользователей (администраторов).
Функция РазрешенныйПользователь()
	Возврат "Стажер";
КонецФункции

// Коды счетов, по которым смотреть остатки (вместе с субсчетами), через запятую.
Функция КодыСчетовТоваров()
	Возврат "41";
КонецФункции

// Часть наименования организации, по остаткам которой ищутся минусы (как в списке организаций).
// Пустая строка - остатки всех организаций вместе.
Функция ОрганизацияДляОстатков()
	Возврат "АРАБИКА";
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет в форму номенклатуры команды (меню "Еще"):
//   Ctrl+D - добавить выделенные карточки в очередь объединения;
//   "Объединить очередь...", "Очистить очередь объединения";
//   "Объединить выделенные сейчас (форма)" - штатная форма БСП "Объединение элементов";
//   "Найти двойников у минусов" - без сочетания клавиш;
//   "Автообъединение дублей у минусов" - только для администратора.
// Любая ошибка здесь только пишется в журнал регистрации: форма номенклатуры должна открываться всегда.
Процедура ДобавитьКоманды(Форма) Экспорт

	Попытка

		Если Не КомандаДоступна() Тогда
			Возврат;
		КонецЕсли;

		ДобавитьКоманду(Форма, "МП_ДобавитьВОчередь", "Добавить в очередь объединения",
			Новый СочетаниеКлавиш(Клавиша.D, Ложь, Истина, Ложь));
		ДобавитьКоманду(Форма, "МП_ОбъединитьОчередь", "Объединить очередь...");
		ДобавитьКоманду(Форма, "МП_ОчиститьОчередь", "Очистить очередь объединения");
		ДобавитьКоманду(Форма, "МП_ОбъединитьВыделенные", "Объединить выделенные сейчас (форма)");
		ДобавитьКоманду(Форма, "МП_НайтиДвойниковМинусов", "Найти двойников у минусов");
		Если ЭтоАдминистратор() Тогда
			ДобавитьКоманду(Форма, "МП_АвтоОбъединение", "Автообъединение дублей у минусов...");
		КонецЕсли;

	Исключение
		ЗаписьЖурналаРегистрации("МП_ПоискДвойников", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Находит группы карточек номенклатуры с одинаковым названием, в которых хотя бы у одной
// карточки отрицательный остаток (по организации из настройки ОрганизацияДляОстатков).
// Названия сравниваются без учета регистра, кавычек, скобок, лишних пробелов, буквы "ё"
// и хвоста "шт" / "1шт" / "1 шт.". Группы, где карточки есть в документах других организаций,
// помечаются "[есть в других фирмах]": объединение затронет и их документы.
//
// Возвращаемое значение:
//   Массив из Структура - Представление (Строка), Ссылки (Массив ссылок, сначала минусовые).
//
Функция НайтиДвойниковМинусов() Экспорт

	Если Не КомандаДоступна() Тогда
		ВызватьИсключение "Поиск двойников недоступен для этого пользователя.";
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Карточки Из ГруппыДвойников() Цикл
		Результат.Добавить(ПредставлениеГруппы(Карточки));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// План автообъединения. В план попадают группы двойников (= и ≈), в которых есть карточка
// с минусом и карточка с положительным остатком. Основная - карточка с наибольшим остатком;
// в нее сливаются только карточки с минусом (нулевые и другие плюсовые не трогаются).
// Группы, где основная или минусовые карточки есть в проводках других организаций, пропускаются.
//
// Возвращаемое значение:
//   Массив из Структура - Представление (Строка), Основная (Ссылка), Сливаемые (Массив ссылок).
//
Функция ПланАвтоОбъединения() Экспорт

	ПроверитьПраваАдминистратора();

	План = Новый Массив;
	Для Каждого Карточки Из ГруппыДвойников() Цикл
		Элемент = ЭлементПлана(Карточки);
		Если Элемент <> Неопределено Тогда
			План.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	Возврат План;

КонецФункции

// Объединяет одну группу плана: ссылки на минусовые карточки во всех данных заменяются
// на основную, минусовые помечаются на удаление. Перед этим условия плана перепроверяются
// по текущим остаткам: если что-то изменилось - исключение, ничего не меняется.
// Результат - см. ЗаменитьСсылкиГруппы.
Функция ОбъединитьГруппу(Знач Основная, Знач Сливаемые) Экспорт

	ПроверитьПраваАдминистратора();

	ВсеСсылки = Новый Массив;
	ВсеСсылки.Добавить(Основная);
	Для Каждого Ссылка Из Сливаемые Цикл
		ВсеСсылки.Добавить(Ссылка);
	КонецЦикла;

	Карточки = Новый Соответствие;
	Выборка = ОстаткиНоменклатуры(ВсеСсылки).Выбрать();
	Пока Выборка.Следующий() Цикл
		Карточки.Вставить(Выборка.Ссылка, Новый Структура("Количество, ЕстьВДругихОрганизациях",
			Выборка.Количество, Выборка.ЕстьВДругихОрганизациях));
	КонецЦикла;

	Данные = Карточки[Основная];
	Если Данные = Неопределено Или Данные.Количество <= 0 Или Данные.ЕстьВДругихОрганизациях Тогда
		ВызватьИсключение СтрШаблон("Условия изменились: у ""%1"" уже нет остатка или есть проводки других фирм.", Основная);
	КонецЕсли;

	ПарыЗамен = Новый Соответствие;
	Для Каждого Ссылка Из Сливаемые Цикл
		Данные = Карточки[Ссылка];
		Если Данные = Неопределено Или Данные.Количество >= 0 Или Данные.ЕстьВДругихОрганизациях Тогда
			ВызватьИсключение СтрШаблон("Условия изменились: у ""%1"" уже нет минуса или есть проводки других фирм.", Ссылка);
		КонецЕсли;
		ПарыЗамен.Вставить(Ссылка, Основная);
	КонецЦикла;

	Возврат ЗаменитьСсылкиГруппы(ПарыЗамен);

КонецФункции

// Добавляет выделенные карточки в очередь объединения как одну группу. Если какая-то из них
// уже есть в очереди, группы склеиваются в одну.
//
// Возвращаемое значение:
//   Структура - ВсегоГрупп (Число), КарточекВГруппе (Число).
//
Функция ДобавитьВОчередь(Знач Ссылки) Экспорт

	Карточки = ТолькоКарточки(Ссылки);
	Если Карточки.Количество() < 2 Тогда
		ВызватьИсключение "Выделите минимум две карточки номенклатуры (группы не объединяются).";
	КонецЕсли;

	Очередь = ЗагрузитьОчередь();
	НоваяОчередь = Новый Массив;
	Для Каждого Группа Из Очередь Цикл
		Пересекается = Ложь;
		Для Каждого Ссылка Из Группа Цикл
			Если Карточки.Найти(Ссылка) <> Неопределено Тогда
				Пересекается = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Пересекается Тогда
			Для Каждого Ссылка Из Группа Цикл
				Если Карточки.Найти(Ссылка) = Неопределено Тогда
					Карточки.Добавить(Ссылка);
				КонецЕсли;
			КонецЦикла;
		Иначе
			НоваяОчередь.Добавить(Группа);
		КонецЕсли;
	КонецЦикла;
	НоваяОчередь.Добавить(Карточки);
	СохранитьОчередь(НоваяОчередь);

	Возврат Новый Структура("ВсегоГрупп, КарточекВГруппе", НоваяОчередь.Количество(), Карточки.Количество());

КонецФункции

// Группы очереди с текущими остатками. Группы, где осталось меньше двух карточек
// (остальные уже объединены или помечены на удаление), из очереди убираются.
//
// Возвращаемое значение:
//   Массив из Структура - Представление (Строка), Ссылки (Массив), ЕстьВДругихОрганизациях (Булево).
//
Функция ОчередьОбъединения() Экспорт

	Если Не КомандаДоступна() Тогда
		ВызватьИсключение "Объединение недоступно для этого пользователя.";
	КонецЕсли;

	Очередь = ЗагрузитьОчередь();
	ВсеСсылки = Новый Массив;
	Для Каждого Группа Из Очередь Цикл
		Для Каждого Ссылка Из Группа Цикл
			ВсеСсылки.Добавить(Ссылка);
		КонецЦикла;
	КонецЦикла;
	Данные = ДанныеКарточек(ВсеСсылки);

	Результат = Новый Массив;
	АктуальнаяОчередь = Новый Массив;
	Для Каждого Группа Из Очередь Цикл
		Карточки = КарточкиГруппы(Группа, Данные);
		Если Карточки.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		АктуальнаяОчередь.Добавить(Группа);

		Основная = ОсновнаяКарточка(Карточки);
		Части = Новый Массив;
		ЕстьВДругихОрганизациях = Ложь;
		Для Каждого Карточка Из Карточки Цикл
			Если Карточка.ЕстьВДругихОрганизациях Тогда
				ЕстьВДругихОрганизациях = Истина;
			КонецЕсли;
			Если Карточка.Ссылка <> Основная.Ссылка Тогда
				Части.Добавить(ПредставлениеКарточки(Карточка));
			КонецЕсли;
		КонецЦикла;
		Представление = ?(ЕстьВДругихОрганизациях, "[есть в других фирмах] ", "")
			+ СтрСоединить(Части, " + ") + "  →  " + ПредставлениеКарточки(Основная);
		Результат.Добавить(Новый Структура("Представление, Ссылки, ЕстьВДругихОрганизациях",
			Представление, Группа, ЕстьВДругихОрганизациях));
	КонецЦикла;

	Если АктуальнаяОчередь.Количество() <> Очередь.Количество() Тогда
		СохранитьОчередь(АктуальнаяОчередь);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Объединяет одну группу очереди по текущим остаткам: основная - карточка с наибольшим остатком
// (при равенстве - самая старая по коду), остальные сливаются в нее и помечаются на удаление.
// После объединения (полного или частичного) группа убирается из очереди.
// Результат - см. ЗаменитьСсылкиГруппы.
//
Функция ОбъединитьИзОчереди(Знач Группа) Экспорт

	Если Не КомандаДоступна() Тогда
		ВызватьИсключение "Объединение недоступно для этого пользователя.";
	КонецЕсли;

	Карточки = КарточкиГруппы(Группа, ДанныеКарточек(Группа));
	Если Карточки.Количество() < 2 Тогда
		УбратьИзОчереди(Группа);
		ВызватьИсключение "В группе осталось меньше двух карточек - убрана из очереди.";
	КонецЕсли;

	Основная = ОсновнаяКарточка(Карточки);
	ПарыЗамен = Новый Соответствие;
	Для Каждого Карточка Из Карточки Цикл
		Если Карточка.Ссылка <> Основная.Ссылка Тогда
			ПарыЗамен.Вставить(Карточка.Ссылка, Основная.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Результат = ЗаменитьСсылкиГруппы(ПарыЗамен);
	УбратьИзОчереди(Группа);
	Возврат Результат;

КонецФункции

Процедура ОчиститьОчередь() Экспорт

	Если Не КомандаДоступна() Тогда
		ВызватьИсключение "Объединение недоступно для этого пользователя.";
	КонецЕсли;
	СохранитьОчередь(Новый Массив);

КонецПроцедуры

// Оставляет из выделенных ссылок только карточки номенклатуры (без групп и помеченных на удаление).
Функция ТолькоКарточки(Знач Ссылки) Экспорт

	Если Не КомандаДоступна() Тогда
		ВызватьИсключение "Объединение недоступно для этого пользователя.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&Ссылки)
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КомандаДоступна()

	Если ВРег(ИмяПользователя()) = ВРег(РазрешенныйПользователь())
		Или ВРег(ПолноеИмяПользователя()) = ВРег(РазрешенныйПользователь()) Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		Возврат Пользователи.ЭтоПолноправныйПользователь();
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Функция ЭтоАдминистратор()

	Попытка
		Возврат Пользователи.ЭтоПолноправныйПользователь();
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

Процедура ПроверитьПраваАдминистратора()

	Если Не ЭтоАдминистратор() Тогда
		ВызватьИсключение "Автообъединение доступно только администратору.";
	КонецЕсли;

КонецПроцедуры

// Замена ссылок штатной функцией БСП - так же, как во встроенном "Поиске и удалении дублей":
// документы меняются по одному. Документы закрытого периода (дата запрета изменения) БСП не меняет:
// они остаются на старой карточке, она не помечается на удаление - это "частичное" объединение.
// Прочие ошибки - исключение (то, что успело замениться, остается замененным).
//
// Возвращаемое значение:
//   Структура - Частично (Булево), НеИзменено (Число мест закрытого периода).
//
Функция ЗаменитьСсылкиГруппы(ПарыЗамен)

	Ошибки = ОбщегоНазначения.ЗаменитьСсылки(ПарыЗамен, Новый Структура("СпособУдаления", "Пометка"));

	ЗакрытыйПериод = 0;
	Прочие = Новый Массив;
	Для Каждого Ошибка Из Ошибки Цикл
		Если СтрНайти(НРег(Ошибка.ТекстОшибки), "запрещенн") > 0 Тогда
			ЗакрытыйПериод = ЗакрытыйПериод + 1;
		Иначе
			Прочие.Добавить(Ошибка.ТекстОшибки);
		КонецЕсли;
	КонецЦикла;

	Если Прочие.Количество() > 0 Тогда
		Итог = "С ошибками (частично заменено): " + СтрСоединить(Прочие, "; ");
	ИначеЕсли ЗакрытыйПериод > 0 Тогда
		Итог = СтрШаблон("Объединено частично: %1 мест в закрытом периоде остались на старой карточке", ЗакрытыйПериод);
	Иначе
		Итог = "Объединено полностью";
	КонецЕсли;
	ЗаписатьВЖурналОбъединение(ПарыЗамен, Итог, Прочие.Количество() > 0);

	Если Прочие.Количество() > 0 Тогда
		ВызватьИсключение Итог;
	КонецЕсли;
	Возврат Новый Структура("Частично, НеИзменено", ЗакрытыйПериод > 0, ЗакрытыйПериод);

КонецФункции

// Журнал регистрации, событие "МП_Объединение": по каждой группе - основная карточка,
// слитые карточки и результат. Отбор по событию дает полный отчет о любом прогоне.
Процедура ЗаписатьВЖурналОбъединение(ПарыЗамен, Итог, ЭтоОшибка)

	Основная = Неопределено;
	Слитые = Новый Массив;
	Для Каждого Пара Из ПарыЗамен Цикл
		Основная = Пара.Значение;
		Слитые.Добавить(СтрШаблон("%1 (%2)", Пара.Ключ, Пара.Ключ.Код));
	КонецЦикла;
	Если Основная = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("МП_Объединение",
		?(ЭтоОшибка, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация),
		Метаданные.Справочники.Номенклатура, Основная,
		СтрШаблон("Основная: %1 (%2)%3Слиты: %4%3%5", Основная, Основная.Код, Символы.ПС,
			СтрСоединить(Слитые, ", "), Итог));

КонецПроцедуры

// Очередь: Массив из Массив ссылок, в настройках текущего пользователя.
Функция ЗагрузитьОчередь()

	Очередь = ХранилищеОбщихНастроек.Загрузить("МП_ОчередьОбъединения", "Очередь");
	Если ТипЗнч(Очередь) <> Тип("Массив") Тогда
		Очередь = Новый Массив;
	КонецЕсли;
	Возврат Очередь;

КонецФункции

Процедура СохранитьОчередь(Очередь)

	ХранилищеОбщихНастроек.Сохранить("МП_ОчередьОбъединения", "Очередь", Очередь);

КонецПроцедуры

// Убирает из очереди группы, пересекающиеся с переданной.
Процедура УбратьИзОчереди(Группа)

	НоваяОчередь = Новый Массив;
	Для Каждого ГруппаОчереди Из ЗагрузитьОчередь() Цикл
		Пересекается = Ложь;
		Для Каждого Ссылка Из ГруппаОчереди Цикл
			Если Группа.Найти(Ссылка) <> Неопределено Тогда
				Пересекается = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Пересекается Тогда
			НоваяОчередь.Добавить(ГруппаОчереди);
		КонецЕсли;
	КонецЦикла;
	СохранитьОчередь(НоваяОчередь);

КонецПроцедуры

// Соответствие: ссылка -> Структура (Ссылка, Наименование, Код, Количество, ЕстьВДругихОрганизациях)
// для существующих карточек (без помеченных на удаление).
Функция ДанныеКарточек(Ссылки)

	Данные = Новый Соответствие;
	Если Ссылки.Количество() = 0 Тогда
		Возврат Данные;
	КонецЕсли;
	Выборка = ОстаткиНоменклатуры(Ссылки).Выбрать();
	Пока Выборка.Следующий() Цикл
		Данные.Вставить(Выборка.Ссылка, Новый Структура("Ссылка, Наименование, Код, Количество, ЕстьВДругихОрганизациях",
			Выборка.Ссылка, Выборка.Наименование, Выборка.Код, Выборка.Количество, Выборка.ЕстьВДругихОрганизациях));
	КонецЦикла;
	Возврат Данные;

КонецФункции

Функция КарточкиГруппы(Группа, Данные)

	Карточки = Новый Массив;
	Для Каждого Ссылка Из Группа Цикл
		Карточка = Данные[Ссылка];
		Если Карточка <> Неопределено Тогда
			Карточки.Добавить(Карточка);
		КонецЕсли;
	КонецЦикла;
	Возврат Карточки;

КонецФункции

// Карточка с наибольшим остатком; при равенстве - самая старая по коду.
Функция ОсновнаяКарточка(Карточки)

	Основная = Карточки[0];
	Для Каждого Карточка Из Карточки Цикл
		Если Карточка.Количество > Основная.Количество
			Или (Карточка.Количество = Основная.Количество И Карточка.Код < Основная.Код) Тогда
			Основная = Карточка;
		КонецЕсли;
	КонецЦикла;
	Возврат Основная;

КонецФункции

Функция ПредставлениеКарточки(Карточка)

	Возврат СтрШаблон("%1 (%2)", СокрЛП(Карточка.Наименование), ОстатокСтрокой(Карточка.Количество));

КонецФункции

// Группы карточек с одинаковым (после чистки) названием, в которых 2+ карточки и есть минус.
//
// Возвращаемое значение:
//   Массив из Массив из Структура - Ссылка, Наименование, Количество, ЕстьВДругихОрганизациях;
//   группы упорядочены по названию.
//
Функция ГруппыДвойников()

	Если Не КомандаДоступна() Тогда
		ВызватьИсключение "Поиск двойников недоступен для этого пользователя.";
	КонецЕсли;

	Группы = Новый Соответствие;
	Выборка = ОстаткиНоменклатуры().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = НормализованноеНаименование(Выборка.Наименование);
		Если Не ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Группа = Группы[Ключ];
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			Группы.Вставить(Ключ, Группа);
		КонецЕсли;
		Группа.Добавить(Новый Структура("Ссылка, Наименование, Количество, ЕстьВДругихОрганизациях",
			Выборка.Ссылка, Выборка.Наименование, Выборка.Количество, Выборка.ЕстьВДругихОрганизациях));
	КонецЦикла;

	Найденные = Новый ТаблицаЗначений;
	Найденные.Колонки.Добавить("Ключ");
	Найденные.Колонки.Добавить("Карточки");
	Для Каждого КлючИЗначение Из Группы Цикл
		Если КлючИЗначение.Значение.Количество() >= 2 И ЕстьМинус(КлючИЗначение.Значение) Тогда
			Строка = Найденные.Добавить();
			Строка.Ключ = КлючИЗначение.Ключ;
			Строка.Карточки = КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	Найденные.Сортировать("Ключ");

	Возврат Найденные.ВыгрузитьКолонку("Карточки");

КонецФункции

// Элемент плана автообъединения для группы или Неопределено, если группа не подходит.
Функция ЭлементПлана(Карточки)

	Основная = Неопределено;
	Для Каждого Карточка Из Карточки Цикл
		Если Карточка.Количество > 0 И (Основная = Неопределено Или Карточка.Количество > Основная.Количество) Тогда
			Основная = Карточка;
		КонецЕсли;
	КонецЦикла;
	Если Основная = Неопределено Или Основная.ЕстьВДругихОрганизациях Тогда
		Возврат Неопределено;
	КонецЕсли;

	Сливаемые = Новый Массив;
	Части = Новый Массив;
	Для Каждого Карточка Из Карточки Цикл
		Если Карточка.Количество >= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Карточка.ЕстьВДругихОрганизациях Тогда
			Возврат Неопределено;
		КонецЕсли;
		Сливаемые.Добавить(Карточка.Ссылка);
		Части.Добавить(СтрШаблон("%1 (%2)", СокрЛП(Карточка.Наименование), ОстатокСтрокой(Карточка.Количество)));
	КонецЦикла;

	Представление = СтрСоединить(Части, " + ") + "  →  "
		+ СтрШаблон("%1 (%2)", СокрЛП(Основная.Наименование), ОстатокСтрокой(Основная.Количество));
	Возврат Новый Структура("Представление, Основная, Сливаемые", Представление, Основная.Ссылка, Сливаемые);

КонецФункции

// Карточки номенклатуры (кроме групп и помеченных на удаление) с текущим количеством
// по счетам товаров. Карточки без движений попадают с нулевым количеством.
// Ссылки - Массив: только эти карточки; Неопределено - все.
Функция ОстаткиНоменклатуры(Ссылки = Неопределено)

	Счета = Новый Массив;
	Для Каждого Код Из СтрРазделить(КодыСчетовТоваров(), ",", Ложь) Цикл
		Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СокрЛП(Код));
		Если Не Счет.Пустая() Тогда
			Счета.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	Если Счета.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("В плане счетов не найдены счета: %1", КодыСчетовТоваров());
	КонецЕсли;

	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура);

	Организация = НайтиОрганизацию();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Наименование КАК Наименование,
	|	Номенклатура.Код КАК Код,
	|	ЕСТЬNULL(Остатки.Количество, 0) КАК Количество,
	|	ДругиеОрганизации.Товар ЕСТЬ НЕ NULL КАК ЕстьВДругихОрганизациях
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ХозрасчетныйОстатки.Субконто1 КАК Товар,
	|			СУММА(ХозрасчетныйОстатки.КоличествоОстаток) КАК Количество
	|		ИЗ
	|			РегистрБухгалтерии.Хозрасчетный.Остатки(, Счет В ИЕРАРХИИ (&Счета), &ВидыСубконто,
	|				&ВсеОрганизации ИЛИ Организация = &Организация) КАК ХозрасчетныйОстатки
	|		СГРУППИРОВАТЬ ПО
	|			ХозрасчетныйОстатки.Субконто1) КАК Остатки
	|		ПО Номенклатура.Ссылка = Остатки.Товар
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			ХозрасчетныйОбороты.Субконто1 КАК Товар
	|		ИЗ
	|			РегистрБухгалтерии.Хозрасчетный.Обороты(, , , Счет В ИЕРАРХИИ (&Счета), &ВидыСубконто,
	|				НЕ &ВсеОрганизации И Организация <> &Организация, , ) КАК ХозрасчетныйОбороты) КАК ДругиеОрганизации
	|		ПО Номенклатура.Ссылка = ДругиеОрганизации.Товар
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления
	|	И (&ВсеКарточки ИЛИ Номенклатура.Ссылка В (&Ссылки))";
	Запрос.УстановитьПараметр("ВсеКарточки", Ссылки = Неопределено);
	Запрос.УстановитьПараметр("Ссылки", ?(Ссылки = Неопределено, Новый Массив, Ссылки));
	Запрос.УстановитьПараметр("Счета", Счета);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
	Запрос.УстановитьПараметр("Организация", Организация);

	Возврат Запрос.Выполнить();

КонецФункции

// Организация из настройки ОрганизацияДляОстатков() или Неопределено (все организации).
Функция НайтиОрганизацию()

	Шаблон = СокрЛП(ОрганизацияДляОстатков());
	Если Не ЗначениеЗаполнено(Шаблон) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка,
	|	Организации.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Наименование ПОДОБНО &Шаблон
	|	И НЕ Организации.ПометкаУдаления";
	Запрос.УстановитьПараметр("Шаблон", "%" + Шаблон + "%");
	Найденные = Запрос.Выполнить().Выгрузить();

	Если Найденные.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("Не найдена организация ""%1"" (настройка ОрганизацияДляОстатков)", Шаблон);
	ИначеЕсли Найденные.Количество() > 1 Тогда
		ВызватьИсключение СтрШаблон("Под ""%1"" подходят несколько организаций: %2. Уточните ОрганизацияДляОстатков",
			Шаблон, СтрСоединить(Найденные.ВыгрузитьКолонку("Наименование"), ", "));
	КонецЕсли;

	Возврат Найденные[0].Ссылка;

КонецФункции

// Ключ для сравнения названий: нижний регистр, "ё" -> "е", без кавычек и скобок,
// одиночные пробелы, без хвоста "шт" / "1шт" / "1 шт.".
Функция НормализованноеНаименование(Знач Наименование)

	Строка = НРег(Наименование);
	Строка = СтрЗаменить(Строка, "ё", "е");
	Для Каждого Символ Из СтрРазделить("""|«|»|“|”|„|'|(|)|" + Символы.Таб + "|" + Символы.НПП, "|", Ложь) Цикл
		Строка = СтрЗаменить(Строка, Символ, " ");
	КонецЦикла;
	Пока СтрНайти(Строка, "  ") > 0 Цикл
		Строка = СтрЗаменить(Строка, "  ", " ");
	КонецЦикла;

	Возврат БезХвостаШт(СокрЛП(Строка));

КонецФункции

// "сигареты бла 1шт", "сигареты бла 1 шт.", "сигареты бла шт" -> "сигареты бла".
// Срезается только "шт" и число 1 перед ним: "бла 2шт" и "бла 10 шт" -> "бла 2" и "бла 10",
// чтобы разные фасовки не попали в одну группу.
// "шт" срезается, только если перед ним пробел или цифра ("борщт" не трогаем).
Функция БезХвостаШт(Строка)

	Остаток = Строка;
	Если СтрЗаканчиваетсяНа(Остаток, ".") Тогда
		Остаток = Лев(Остаток, СтрДлина(Остаток) - 1);
	КонецЕсли;
	Если Не СтрЗаканчиваетсяНа(Остаток, "шт") Тогда
		Возврат Строка;
	КонецЕсли;
	Остаток = Лев(Остаток, СтрДлина(Остаток) - 2);

	ПредыдущийСимвол = Прав(Остаток, 1);
	Если Не (ПредыдущийСимвол = " " Или (ЗначениеЗаполнено(ПредыдущийСимвол)
		И СтрНайти("0123456789", ПредыдущийСимвол) > 0)) Тогда
		Возврат Строка;
	КонецЕсли;
	Остаток = СокрП(Остаток);

	ПозицияПробела = СтрНайти(Остаток, " ", НаправлениеПоиска.СКонца);
	Если Сред(Остаток, ПозицияПробела + 1) = "1" Тогда
		Остаток = ?(ПозицияПробела > 0, СокрП(Лев(Остаток, ПозицияПробела - 1)), "");
	КонецЕсли;

	Возврат ?(ЗначениеЗаполнено(Остаток), Остаток, Строка);

КонецФункции

Функция ЕстьМинус(Карточки)

	Для Каждого Карточка Из Карточки Цикл
		Если Карточка.Количество < 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Представление: "= " - названия совпадают полностью, "≈ " - совпадают после чистки.
// Сначала карточки с минусом, затем остальные: "Ессе блек голд шт (-5) | ESSE BLACK GOLD 1шт (+12)".
Функция ПредставлениеГруппы(Карточки)

	Ссылки = Новый Массив;
	Части = Новый Массив;
	Точное = Истина;
	ЕстьВДругихОрганизациях = Ложь;
	ПервоеНаименование = ВРег(СокрЛП(Карточки[0].Наименование));

	Для Проход = 1 По 2 Цикл
		Для Каждого Карточка Из Карточки Цикл
			Если (Проход = 1) <> (Карточка.Количество < 0) Тогда
				Продолжить;
			КонецЕсли;
			Ссылки.Добавить(Карточка.Ссылка);
			Части.Добавить(СтрШаблон("%1 (%2)", СокрЛП(Карточка.Наименование), ОстатокСтрокой(Карточка.Количество)));
			Если ВРег(СокрЛП(Карточка.Наименование)) <> ПервоеНаименование Тогда
				Точное = Ложь;
			КонецЕсли;
			Если Карточка.ЕстьВДругихОрганизациях Тогда
				ЕстьВДругихОрганизациях = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Представление = ?(Точное, "= ", "≈ ") + ?(ЕстьВДругихОрганизациях, "[есть в других фирмах] ", "")
		+ СтрСоединить(Части, "  |  ");
	Возврат Новый Структура("Представление, Ссылки", Представление, Ссылки);

КонецФункции

Функция ОстатокСтрокой(Количество)

	Если Количество > 0 Тогда
		Возврат "+" + Формат(Количество, "ЧГ=0");
	ИначеЕсли Количество < 0 Тогда
		Возврат Формат(Количество, "ЧГ=0");
	КонецЕсли;
	Возврат "0";

КонецФункции

Процедура ДобавитьКоманду(Форма, Имя, Заголовок, СочетаниеКлавиш = Неопределено)

	Если Форма.Команды.Найти(Имя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Команда = Форма.Команды.Добавить(Имя);
	Команда.Заголовок = Заголовок;
	Команда.Действие = Имя;
	Если СочетаниеКлавиш <> Неопределено Тогда
		Команда.СочетаниеКлавиш = СочетаниеКлавиш;
	КонецЕсли;

	// Кнопка нужна, чтобы работало сочетание клавиш; прячем ее в меню "Еще".
	Кнопка = Форма.Элементы.Добавить(Имя, Тип("КнопкаФормы"), КоманднаяПанельДляКнопок(Форма));
	Кнопка.ИмяКоманды = Имя;
	Кнопка.ТолькоВоВсехДействиях = Истина;

КонецПроцедуры

// Если командная панель формы скрыта, кнопки кладем в панель списка.
Функция КоманднаяПанельДляКнопок(Форма)

	Если Форма.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Нет Тогда
		Список = Форма.Элементы.Найти("Список");
		Если Список <> Неопределено Тогда
			Возврат Список.КоманднаяПанель;
		КонецЕсли;
	КонецЕсли;

	Возврат Форма.КоманднаяПанель;

КонецФункции

#КонецОбласти
