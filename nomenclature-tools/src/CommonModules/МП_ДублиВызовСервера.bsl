// Поиск двойников у номенклатуры с отрицательным остатком.
// Общий модуль расширения. Свойства: Сервер = Истина, Вызов сервера = Истина.
// Модуль только читает данные: ничего не записывает и не удаляет.

#Область Настройки

// Кому доступна команда, кроме полноправных пользователей (администраторов).
Функция РазрешенныйПользователь()
	Возврат "Стажер";
КонецФункции

// Коды счетов, по которым смотреть остатки (вместе с субсчетами), через запятую.
Функция КодыСчетовТоваров()
	Возврат "41";
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет в форму номенклатуры команды (меню "Еще"):
//   Ctrl+Shift+Q - объединить выделенные карточки (штатная форма БСП "Объединение элементов");
//   "Найти двойников у минусов" - без сочетания клавиш.
// Любая ошибка здесь только пишется в журнал регистрации: форма номенклатуры должна открываться всегда.
Процедура ДобавитьКоманды(Форма) Экспорт

	Попытка

		Если Не КомандаДоступна() Тогда
			Возврат;
		КонецЕсли;

		ДобавитьКоманду(Форма, "МП_ОбъединитьВыделенные", "Объединить выделенные",
			Новый СочетаниеКлавиш(Клавиша.Q, Ложь, Истина, Истина));
		ДобавитьКоманду(Форма, "МП_НайтиДвойниковМинусов", "Найти двойников у минусов");

	Исключение
		ЗаписьЖурналаРегистрации("МП_ПоискДвойников", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Находит группы карточек номенклатуры с одинаковым названием, в которых хотя бы у одной
// карточки отрицательный остаток. Названия сравниваются без учета регистра, кавычек, скобок,
// лишних пробелов, буквы "ё" и хвоста "шт" / "1шт" / "1 шт.".
//
// Возвращаемое значение:
//   Массив из Структура - Представление (Строка), Ссылки (Массив ссылок, сначала минусовые).
//
Функция НайтиДвойниковМинусов() Экспорт

	Если Не КомандаДоступна() Тогда
		ВызватьИсключение "Поиск двойников недоступен для этого пользователя.";
	КонецЕсли;

	Группы = Новый Соответствие;
	Выборка = ОстаткиНоменклатуры().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = НормализованноеНаименование(Выборка.Наименование);
		Если Не ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Группа = Группы[Ключ];
		Если Группа = Неопределено Тогда
			Группа = Новый Массив;
			Группы.Вставить(Ключ, Группа);
		КонецЕсли;
		Группа.Добавить(Новый Структура("Ссылка, Наименование, Количество",
			Выборка.Ссылка, Выборка.Наименование, Выборка.Количество));
	КонецЦикла;

	Найденные = Новый ТаблицаЗначений;
	Найденные.Колонки.Добавить("Ключ");
	Найденные.Колонки.Добавить("Представление");
	Найденные.Колонки.Добавить("Ссылки");

	Для Каждого КлючИЗначение Из Группы Цикл
		Карточки = КлючИЗначение.Значение;
		Если Карточки.Количество() < 2 Или Не ЕстьМинус(Карточки) Тогда
			Продолжить;
		КонецЕсли;
		Строка = Найденные.Добавить();
		Строка.Ключ = КлючИЗначение.Ключ;
		ЗаполнитьГруппу(Строка, Карточки);
	КонецЦикла;

	Найденные.Сортировать("Ключ");

	Результат = Новый Массив;
	Для Каждого Строка Из Найденные Цикл
		Результат.Добавить(Новый Структура("Представление, Ссылки", Строка.Представление, Строка.Ссылки));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Оставляет из выделенных ссылок только карточки номенклатуры (без групп и помеченных на удаление).
Функция ТолькоКарточки(Знач Ссылки) Экспорт

	Если Не КомандаДоступна() Тогда
		ВызватьИсключение "Объединение недоступно для этого пользователя.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка В (&Ссылки)
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КомандаДоступна()

	Если ВРег(ИмяПользователя()) = ВРег(РазрешенныйПользователь())
		Или ВРег(ПолноеИмяПользователя()) = ВРег(РазрешенныйПользователь()) Тогда
		Возврат Истина;
	КонецЕсли;

	Попытка
		Возврат Пользователи.ЭтоПолноправныйПользователь();
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

// Все карточки номенклатуры (кроме групп и помеченных на удаление) с текущим количеством
// по счетам товаров. Карточки без движений попадают с нулевым количеством.
Функция ОстаткиНоменклатуры()

	Счета = Новый Массив;
	Для Каждого Код Из СтрРазделить(КодыСчетовТоваров(), ",", Ложь) Цикл
		Счет = ПланыСчетов.Хозрасчетный.НайтиПоКоду(СокрЛП(Код));
		Если Не Счет.Пустая() Тогда
			Счета.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	Если Счета.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("В плане счетов не найдены счета: %1", КодыСчетовТоваров());
	КонецЕсли;

	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.Наименование КАК Наименование,
	|	ЕСТЬNULL(Остатки.Количество, 0) КАК Количество
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ХозрасчетныйОстатки.Субконто1 КАК Номенклатура,
	|			СУММА(ХозрасчетныйОстатки.КоличествоОстаток) КАК Количество
	|		ИЗ
	|			РегистрБухгалтерии.Хозрасчетный.Остатки(, Счет В ИЕРАРХИИ (&Счета), &ВидыСубконто, ) КАК ХозрасчетныйОстатки
	|		СГРУППИРОВАТЬ ПО
	|			ХозрасчетныйОстатки.Субконто1) КАК Остатки
	|		ПО Номенклатура.Ссылка = Остатки.Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления";
	Запрос.УстановитьПараметр("Счета", Счета);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);

	Возврат Запрос.Выполнить();

КонецФункции

// Ключ для сравнения названий: нижний регистр, "ё" -> "е", без кавычек и скобок,
// одиночные пробелы, без хвоста "шт" / "1шт" / "1 шт.".
Функция НормализованноеНаименование(Знач Наименование)

	Строка = НРег(Наименование);
	Строка = СтрЗаменить(Строка, "ё", "е");
	Для Каждого Символ Из СтрРазделить("""|«|»|“|”|„|'|(|)|" + Символы.Таб + "|" + Символы.НПП, "|", Ложь) Цикл
		Строка = СтрЗаменить(Строка, Символ, " ");
	КонецЦикла;
	Пока СтрНайти(Строка, "  ") > 0 Цикл
		Строка = СтрЗаменить(Строка, "  ", " ");
	КонецЦикла;

	Возврат БезХвостаШт(СокрЛП(Строка));

КонецФункции

// "сигареты бла 1шт", "сигареты бла 1 шт.", "сигареты бла шт" -> "сигареты бла".
// Срезается только "шт" и число 1 перед ним: "бла 2шт" и "бла 10 шт" -> "бла 2" и "бла 10",
// чтобы разные фасовки не попали в одну группу.
// "шт" срезается, только если перед ним пробел или цифра ("борщт" не трогаем).
Функция БезХвостаШт(Строка)

	Остаток = Строка;
	Если СтрЗаканчиваетсяНа(Остаток, ".") Тогда
		Остаток = Лев(Остаток, СтрДлина(Остаток) - 1);
	КонецЕсли;
	Если Не СтрЗаканчиваетсяНа(Остаток, "шт") Тогда
		Возврат Строка;
	КонецЕсли;
	Остаток = Лев(Остаток, СтрДлина(Остаток) - 2);

	ПредыдущийСимвол = Прав(Остаток, 1);
	Если Не (ПредыдущийСимвол = " " Или (ЗначениеЗаполнено(ПредыдущийСимвол)
		И СтрНайти("0123456789", ПредыдущийСимвол) > 0)) Тогда
		Возврат Строка;
	КонецЕсли;
	Остаток = СокрП(Остаток);

	ПозицияПробела = СтрНайти(Остаток, " ", НаправлениеПоиска.СКонца);
	Если Сред(Остаток, ПозицияПробела + 1) = "1" Тогда
		Остаток = ?(ПозицияПробела > 0, СокрП(Лев(Остаток, ПозицияПробела - 1)), "");
	КонецЕсли;

	Возврат ?(ЗначениеЗаполнено(Остаток), Остаток, Строка);

КонецФункции

Функция ЕстьМинус(Карточки)

	Для Каждого Карточка Из Карточки Цикл
		Если Карточка.Количество < 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Представление: "= " - названия совпадают полностью, "≈ " - совпадают после чистки.
// Сначала карточки с минусом, затем остальные: "Ессе блек голд шт (-5) | ESSE BLACK GOLD 1шт (+12)".
Процедура ЗаполнитьГруппу(Строка, Карточки)

	Ссылки = Новый Массив;
	Части = Новый Массив;
	Точное = Истина;
	ПервоеНаименование = ВРег(СокрЛП(Карточки[0].Наименование));

	Для Проход = 1 По 2 Цикл
		Для Каждого Карточка Из Карточки Цикл
			Если (Проход = 1) <> (Карточка.Количество < 0) Тогда
				Продолжить;
			КонецЕсли;
			Ссылки.Добавить(Карточка.Ссылка);
			Части.Добавить(СтрШаблон("%1 (%2)", СокрЛП(Карточка.Наименование), ОстатокСтрокой(Карточка.Количество)));
			Если ВРег(СокрЛП(Карточка.Наименование)) <> ПервоеНаименование Тогда
				Точное = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Строка.Ссылки = Ссылки;
	Строка.Представление = ?(Точное, "= ", "≈ ") + СтрСоединить(Части, "  |  ");

КонецПроцедуры

Функция ОстатокСтрокой(Количество)

	Если Количество > 0 Тогда
		Возврат "+" + Формат(Количество, "ЧГ=0");
	ИначеЕсли Количество < 0 Тогда
		Возврат Формат(Количество, "ЧГ=0");
	КонецЕсли;
	Возврат "0";

КонецФункции

Процедура ДобавитьКоманду(Форма, Имя, Заголовок, СочетаниеКлавиш = Неопределено)

	Если Форма.Команды.Найти(Имя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Команда = Форма.Команды.Добавить(Имя);
	Команда.Заголовок = Заголовок;
	Команда.Действие = Имя;
	Если СочетаниеКлавиш <> Неопределено Тогда
		Команда.СочетаниеКлавиш = СочетаниеКлавиш;
	КонецЕсли;

	// Кнопка нужна, чтобы работало сочетание клавиш; прячем ее в меню "Еще".
	Кнопка = Форма.Элементы.Добавить(Имя, Тип("КнопкаФормы"), КоманднаяПанельДляКнопок(Форма));
	Кнопка.ИмяКоманды = Имя;
	Кнопка.ТолькоВоВсехДействиях = Истина;

КонецПроцедуры

// Если командная панель формы скрыта, кнопки кладем в панель списка.
Функция КоманднаяПанельДляКнопок(Форма)

	Если Форма.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Нет Тогда
		Список = Форма.Элементы.Найти("Список");
		Если Список <> Неопределено Тогда
			Возврат Список.КоманднаяПанель;
		КонецЕсли;
	КонецЕсли;

	Возврат Форма.КоманднаяПанель;

КонецФункции

#КонецОбласти
