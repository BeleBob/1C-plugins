// Объединение номенклатуры и поиск двойников у минусов - клиентская часть.
// Общий модуль расширения. Свойства: Клиент (управляемое приложение) = Истина.
// Объединение выполняет штатная форма БСП "Объединение элементов" (через ее программный интерфейс
// ПоискИУдалениеДублейКлиент.ОбъединитьВыделенные): она сама показывает места использования,
// спрашивает основной элемент и подтверждение.

#Область ПрограммныйИнтерфейс

// Открывает штатное объединение для выделенных в списке карточек номенклатуры.
Процедура ОбъединитьВыделенные(Форма) Экспорт

	Попытка
		Ссылки = МП_ДублиВызовСервера.ТолькоКарточки(ВыделеннаяНоменклатура(Форма));
	Исключение
		ПоказатьОшибку("Объединение номенклатуры", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Ссылки.Количество() < 2 Тогда
		ПоказатьОшибку("Объединение номенклатуры",
			"Выделите минимум две карточки номенклатуры (группы не объединяются).");
		Возврат;
	КонецЕсли;

	ОткрытьОбъединение(Ссылки);

КонецПроцедуры

// Показывает найденные группы двойников; выбранная группа открывается на объединение.
// После объединения команду можно запустить снова - объединенные группы из списка пропадут.
Процедура НайтиДвойниковМинусов() Экспорт

	Попытка
		Группы = МП_ДублиВызовСервера.НайтиДвойниковМинусов();
	Исключение
		ПоказатьОшибку("Поиск двойников", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Группы.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Двойников у минусов не найдено");
		Возврат;
	КонецЕсли;

	Список = Новый СписокЗначений;
	Для Каждого Группа Из Группы Цикл
		Список.Добавить(Группа.Ссылки, Группа.Представление);
	КонецЦикла;

	Список.ПоказатьВыборЭлемента(Новый ОписаниеОповещения("ПослеВыбораГруппы", МП_ДублиКлиент),
		СтрШаблон("Двойники у минусов: %1 (= одинаковые, ≈ похожие). Выберите группу для объединения",
			Группы.Количество()));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПослеВыбораГруппы(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОткрытьОбъединение(ВыбранныйЭлемент.Значение);

КонецПроцедуры

Процедура ОткрытьОбъединение(Ссылки)

	Попытка
		ПоискИУдалениеДублейКлиент.ОбъединитьВыделенные(Ссылки);
	Исключение
		ПоказатьОшибку("Объединение номенклатуры", "Не удалось открыть объединение (нужны права администратора?): "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция ВыделеннаяНоменклатура(Форма)

	Ссылки = Новый Массив;

	// Курсор может стоять в поле поиска - тогда берем выделение из основного списка.
	Если ТипЗнч(Форма.ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
		Таблица = Форма.ТекущийЭлемент;
	Иначе
		Таблица = Форма.Элементы.Найти("Список");
	КонецЕсли;
	Если Таблица = Неопределено Тогда
		Возврат Ссылки;
	КонецЕсли;

	ТипНоменклатуры = Тип("СправочникСсылка.Номенклатура");
	Для Каждого Строка Из Таблица.ВыделенныеСтроки Цикл
		Если ТипЗнч(Строка) = ТипНоменклатуры Тогда
			Ссылки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;

	Возврат Ссылки;

КонецФункции

Процедура ПоказатьОшибку(Заголовок, Текст)

	ПоказатьОповещениеПользователя(Заголовок, , Текст);
	Сообщить(Текст);

КонецПроцедуры

#КонецОбласти
