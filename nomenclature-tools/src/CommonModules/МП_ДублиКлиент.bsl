// Объединение номенклатуры, поиск и автообъединение двойников у минусов - клиентская часть.
// Общий модуль расширения. Свойства: Клиент (управляемое приложение) = Истина.
// Объединение выполняет штатная форма БСП "Объединение элементов" (через ее программный интерфейс
// ПоискИУдалениеДублейКлиент.ОбъединитьВыделенные): она сама показывает места использования,
// спрашивает основной элемент и подтверждение.

#Область ПрограммныйИнтерфейс

// Ctrl+D: мгновенно добавляет выделенные карточки в очередь объединения (без формы и ожидания).
Процедура ДобавитьВОчередь(Форма) Экспорт

	Попытка
		Итог = МП_ДублиВызовСервера.ДобавитьВОчередь(ВыделеннаяНоменклатура(Форма));
	Исключение
		ПоказатьОшибку("Очередь объединения", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	ПоказатьОповещениеПользователя(СтрШаблон("В очереди: %1 гр.", Итог.ВсегоГрупп), ,
		СтрШаблон("Добавлена группа из %1 карточек", Итог.КарточекВГруппе));

КонецПроцедуры

// Показывает очередь с флажками и объединяет отмеченные группы подряд.
// Группы с проводками других фирм по умолчанию не отмечены.
Процедура ОбъединитьОчередь() Экспорт

	Попытка
		Очередь = МП_ДублиВызовСервера.ОчередьОбъединения();
	Исключение
		ПоказатьОшибку("Очередь объединения", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Очередь.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Очередь объединения пуста");
		Возврат;
	КонецЕсли;

	Список = Новый СписокЗначений;
	Для Каждого Элемент Из Очередь Цикл
		Список.Добавить(Элемент.Ссылки, Элемент.Представление, Не Элемент.ЕстьВДругихОрганизациях);
	КонецЦикла;

	Список.ПоказатьОтметкуЭлементов(Новый ОписаниеОповещения("ОчередьПослеОтметки", МП_ДублиКлиент),
		СтрШаблон("Очередь объединения: %1 гр. (карточки → основная с наибольшим остатком)", Очередь.Количество()));

КонецПроцедуры

Процедура ОчиститьОчередь() Экспорт

	Попытка
		МП_ДублиВызовСервера.ОчиститьОчередь();
	Исключение
		ПоказатьОшибку("Очередь объединения", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	ПоказатьОповещениеПользователя("Очередь объединения очищена");

КонецПроцедуры

// Открывает штатное объединение для выделенных в списке карточек номенклатуры.
Процедура ОбъединитьВыделенные(Форма) Экспорт

	Попытка
		Ссылки = МП_ДублиВызовСервера.ТолькоКарточки(ВыделеннаяНоменклатура(Форма));
	Исключение
		ПоказатьОшибку("Объединение номенклатуры", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Ссылки.Количество() < 2 Тогда
		ПоказатьОшибку("Объединение номенклатуры",
			"Выделите минимум две карточки номенклатуры (группы не объединяются).");
		Возврат;
	КонецЕсли;

	ОткрытьОбъединение(Ссылки);

КонецПроцедуры

// Показывает найденные группы двойников; выбранная группа открывается на объединение.
// После объединения команду можно запустить снова - объединенные группы из списка пропадут.
Процедура НайтиДвойниковМинусов() Экспорт

	Попытка
		Группы = МП_ДублиВызовСервера.НайтиДвойниковМинусов();
	Исключение
		ПоказатьОшибку("Поиск двойников", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Группы.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Двойников у минусов не найдено");
		Возврат;
	КонецЕсли;

	Список = Новый СписокЗначений;
	Для Каждого Группа Из Группы Цикл
		Список.Добавить(Группа.Ссылки, Группа.Представление);
	КонецЦикла;

	Список.ПоказатьВыборЭлемента(Новый ОписаниеОповещения("ПослеВыбораГруппы", МП_ДублиКлиент),
		СтрШаблон("Двойники у минусов: %1 (= одинаковые, ≈ похожие). Выберите группу для объединения",
			Группы.Количество()));

КонецПроцедуры

// Автообъединение (только администратор): показывает план с флажками (все отмечены),
// после подтверждения объединяет отмеченные группы по одной. Минусовые карточки сливаются
// в карточку с наибольшим остатком и помечаются на удаление.
Процедура АвтоОбъединение() Экспорт

	Попытка
		План = МП_ДублиВызовСервера.ПланАвтоОбъединения();
	Исключение
		ПоказатьОшибку("Автообъединение", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если План.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Автообъединение", , "Нет групп, где минус можно слить в карточку с остатком");
		Возврат;
	КонецЕсли;

	Список = Новый СписокЗначений;
	Для Каждого Элемент Из План Цикл
		Список.Добавить(Элемент, Элемент.Представление, Истина);
	КонецЦикла;

	Список.ПоказатьОтметкуЭлементов(Новый ОписаниеОповещения("АвтоОбъединениеПослеОтметки", МП_ДублиКлиент),
		СтрШаблон("Автообъединение: %1 групп (минус → карточка с остатком). Снимите флажки с лишних", План.Количество()));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Асинх Процедура ОчередьПослеОтметки(Список, ДополнительныеПараметры) Экспорт

	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Выбранные = Новый Массив;
	Для Каждого ЭлементСписка Из Список Цикл
		Если ЭлементСписка.Пометка Тогда
			Выбранные.Добавить(ЭлементСписка);
		КонецЕсли;
	КонецЦикла;
	Если Выбранные.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Ничего не отмечено");
		Возврат;
	КонецЕсли;

	Ответ = Ждать ВопросАсинх(СтрШаблон("Объединить групп: %1?
		|
		|В каждой группе карточки сливаются в карточку с наибольшим остатком: ссылки на них
		|заменяются во ВСЕХ документах, сами они помечаются на удаление.
		|Отменить можно только из резервной копии.", Выбранные.Количество()),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Объединено = 0;
	Ошибки = Новый Массив;
	Для Индекс = 0 По Выбранные.ВГраница() Цикл
		ЭлементСписка = Выбранные[Индекс];
		Состояние(СтрШаблон("Объединение очереди: %1 из %2", Индекс + 1, Выбранные.Количество()), ,
			ЭлементСписка.Представление);
		Попытка
			МП_ДублиВызовСервера.ОбъединитьИзОчереди(ЭлементСписка.Значение);
			Объединено = Объединено + 1;
		Исключение
			Ошибки.Добавить(ЭлементСписка.Представление + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	ОповеститьОбИзменении(Тип("СправочникСсылка.Номенклатура"));
	ПоказатьОповещениеПользователя(СтрШаблон("Объединено групп: %1 из %2", Объединено, Выбранные.Количество()), ,
		?(Ошибки.Количество() > 0, "Не объединенные остались в очереди, причины - в сообщениях", ""));
	Для Каждого Текст Из Ошибки Цикл
		Сообщить(Текст);
	КонецЦикла;

КонецПроцедуры

Асинх Процедура АвтоОбъединениеПослеОтметки(Список, ДополнительныеПараметры) Экспорт

	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Выбранные = Новый Массив;
	Для Каждого ЭлементСписка Из Список Цикл
		Если ЭлементСписка.Пометка Тогда
			Выбранные.Добавить(ЭлементСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	Если Выбранные.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Ничего не отмечено");
		Возврат;
	КонецЕсли;

	Ответ = Ждать ВопросАсинх(СтрШаблон("Объединить групп: %1?
		|
		|Ссылки на карточки с минусом будут заменены во ВСЕХ документах на карточки с остатком,
		|карточки с минусом будут помечены на удаление.
		|Отменить можно только из резервной копии.", Выбранные.Количество()),
		РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Объединено = 0;
	Ошибки = Новый Массив;
	Для Индекс = 0 По Выбранные.ВГраница() Цикл
		Элемент = Выбранные[Индекс];
		Состояние(СтрШаблон("Автообъединение: %1 из %2", Индекс + 1, Выбранные.Количество()), , Элемент.Представление);
		Попытка
			МП_ДублиВызовСервера.ОбъединитьГруппу(Элемент.Основная, Элемент.Сливаемые);
			Объединено = Объединено + 1;
		Исключение
			Ошибки.Добавить(Элемент.Представление + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;

	ОповеститьОбИзменении(Тип("СправочникСсылка.Номенклатура"));
	ПоказатьОповещениеПользователя(СтрШаблон("Объединено групп: %1 из %2", Объединено, Выбранные.Количество()), ,
		?(Ошибки.Количество() > 0, "Пропущенные группы и причины - в сообщениях", ""));
	Для Каждого Текст Из Ошибки Цикл
		Сообщить(Текст);
	КонецЦикла;

КонецПроцедуры

Процедура ПослеВыбораГруппы(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОткрытьОбъединение(ВыбранныйЭлемент.Значение);

КонецПроцедуры

Процедура ОткрытьОбъединение(Ссылки)

	Попытка
		ПоискИУдалениеДублейКлиент.ОбъединитьВыделенные(Ссылки);
	Исключение
		ПоказатьОшибку("Объединение номенклатуры", "Не удалось открыть объединение (нужны права администратора?): "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Функция ВыделеннаяНоменклатура(Форма)

	Ссылки = Новый Массив;

	// Курсор может стоять в поле поиска - тогда берем выделение из основного списка.
	Если ТипЗнч(Форма.ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
		Таблица = Форма.ТекущийЭлемент;
	Иначе
		Таблица = Форма.Элементы.Найти("Список");
	КонецЕсли;
	Если Таблица = Неопределено Тогда
		Возврат Ссылки;
	КонецЕсли;

	ТипНоменклатуры = Тип("СправочникСсылка.Номенклатура");
	Для Каждого Строка Из Таблица.ВыделенныеСтроки Цикл
		Если ТипЗнч(Строка) = ТипНоменклатуры Тогда
			Ссылки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;

	Возврат Ссылки;

КонецФункции

Процедура ПоказатьОшибку(Заголовок, Текст)

	ПоказатьОповещениеПользователя(Заголовок, , Текст);
	Сообщить(Текст);

КонецПроцедуры

#КонецОбласти
