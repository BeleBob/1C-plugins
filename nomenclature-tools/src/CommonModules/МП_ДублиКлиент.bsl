// Поиск двойников у номенклатуры с отрицательным остатком - клиентская часть.
// Общий модуль расширения. Свойства: Клиент (управляемое приложение) = Истина.
// Объединение выполняет штатная форма БСП "Объединение элементов": она сама показывает
// места использования, спрашивает основной элемент и подтверждение.

#Область ПрограммныйИнтерфейс

// Открывает штатное объединение для выделенных в списке карточек номенклатуры.
Процедура ОбъединитьВыделенные(Форма) Экспорт

	Ссылки = ВыделеннаяНоменклатура(Форма);
	Если Ссылки.Количество() < 2 Тогда
		ПоказатьОшибку("Для объединения выделите минимум две карточки номенклатуры.");
		Возврат;
	КонецЕсли;

	Очередь = Новый Массив;
	Очередь.Добавить(Ссылки);
	ОткрытьСледующееОбъединение(Очередь);

КонецПроцедуры

// Показывает найденные группы двойников с флажками; отмеченные открываются на объединение по очереди.
Процедура НайтиДвойниковМинусов() Экспорт

	Попытка
		Группы = МП_ДублиВызовСервера.НайтиДвойниковМинусов();
	Исключение
		ПоказатьОшибку(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Если Группы.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Двойников у минусов не найдено");
		Возврат;
	КонецЕсли;

	Список = Новый СписокЗначений;
	Для Каждого Группа Из Группы Цикл
		Список.Добавить(Группа.Ссылки, Группа.Представление);
	КонецЦикла;

	Список.ПоказатьОтметкуЭлементов(Новый ОписаниеОповещения("ПослеОтметкиГрупп", МП_ДублиКлиент),
		СтрШаблон("Двойники у минусов: %1 (= одинаковые, ≈ похожие). Отметьте, что объединять", Группы.Количество()));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПослеОтметкиГрупп(Список, ДополнительныеПараметры) Экспорт

	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Очередь = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Если Элемент.Пометка Тогда
			Очередь.Добавить(Элемент.Значение);
		КонецЕсли;
	КонецЦикла;

	Если Очередь.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Ничего не отмечено");
		Возврат;
	КонецЕсли;

	ОткрытьСледующееОбъединение(Очередь);

КонецПроцедуры

Процедура ОткрытьСледующееОбъединение(Очередь)

	Ссылки = Очередь[0];
	Очередь.Удалить(0);

	Попытка
		ОткрытьФорму("Обработка.ЗаменаИОбъединениеЭлементов.Форма.ОбъединениеЭлементов",
			Новый Структура("НаборСсылок", Ссылки), , Новый УникальныйИдентификатор, , ,
			Новый ОписаниеОповещения("ПослеОбъединения", МП_ДублиКлиент, Очередь));
	Исключение
		ПоказатьОшибку("Не удалось открыть объединение (нужны права администратора?): "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ПослеОбъединения(Результат, Очередь) Экспорт

	ОповеститьОбИзменении(Тип("СправочникСсылка.Номенклатура"));

	Если Очередь.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаОСледующей", МП_ДублиКлиент, Очередь),
		СтрШаблон("Осталось групп: %1. Открыть следующую?", Очередь.Количество()), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

Процедура ПослеВопросаОСледующей(Ответ, Очередь) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОткрытьСледующееОбъединение(Очередь);
	КонецЕсли;

КонецПроцедуры

Функция ВыделеннаяНоменклатура(Форма)

	Ссылки = Новый Массив;

	// Курсор может стоять в поле поиска - тогда берем выделение из основного списка.
	Если ТипЗнч(Форма.ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
		Таблица = Форма.ТекущийЭлемент;
	Иначе
		Таблица = Форма.Элементы.Найти("Список");
	КонецЕсли;
	Если Таблица = Неопределено Тогда
		Возврат Ссылки;
	КонецЕсли;

	ТипНоменклатуры = Тип("СправочникСсылка.Номенклатура");
	Для Каждого Строка Из Таблица.ВыделенныеСтроки Цикл
		Если ТипЗнч(Строка) = ТипНоменклатуры Тогда
			Ссылки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;

	Возврат Ссылки;

КонецФункции

Процедура ПоказатьОшибку(Текст)

	ПоказатьОповещениеПользователя("Объединение номенклатуры", , Текст);
	Сообщить(Текст);

КонецПроцедуры

#КонецОбласти
