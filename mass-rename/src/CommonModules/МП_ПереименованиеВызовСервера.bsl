// Массовое переименование номенклатуры в текст из буфера обмена, с откатом.
// Общий модуль расширения. Свойства: Сервер = Истина, Вызов сервера = Истина.

#Область Настройки

// Команды появятся только у этого пользователя (имя входа или полное имя).
// Пустая строка - у всех пользователей.
Функция РазрешенныйПользователь()
	Возврат "Стажер";
КонецФункции

// Имя компьютера, на котором доступны команды (то, что выводит команда hostname в Windows).
// Пустая строка - на любом компьютере.
Функция РазрешенныйКомпьютер()
	Возврат "";
КонецФункции

// Сколько последних операций можно откатить.
Функция ГлубинаИстории()
	Возврат 20;
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет в форму номенклатуры команды с горячими клавишами:
//   Ctrl+Shift+V - переименовать выделенные позиции в текст из буфера обмена;
//   Ctrl+Shift+Z - откатить последнее переименование.
// Вызывается из ПриСозданииНаСервере формы.
Процедура ДобавитьКоманды(Форма) Экспорт

	Если Не КомандыДоступны() Тогда
		Возврат;
	КонецЕсли;

	ДобавитьКоманду(Форма, "МП_ПереименоватьИзБуфера", "Переименовать в текст из буфера обмена",
		Новый СочетаниеКлавиш(Клавиша.V, Ложь, Истина, Истина));
	ДобавитьКоманду(Форма, "МП_ОткатитьПереименование", "Откатить последнее переименование",
		Новый СочетаниеКлавиш(Клавиша.Z, Ложь, Истина, Истина));

КонецПроцедуры

// Переименовывает элементы номенклатуры (Наименование и Полное наименование).
// Все элементы записываются в одной транзакции: либо все, либо ни одного.
//
// Возвращаемое значение:
//   Структура - Переименовано (Число), Пропущено (Массив строк с причинами).
//
Функция Переименовать(Знач Ссылки, Знач НовоеНаименование) Экспорт

	ПроверитьДоступ();

	НовоеНаименование = СокрЛП(НовоеНаименование);
	Если Не ЗначениеЗаполнено(НовоеНаименование) Тогда
		ВызватьИсключение "Новое наименование пустое.";
	КонецЕсли;

	МетаданныеНоменклатуры = Метаданные.Справочники.Номенклатура;
	Если СтрДлина(НовоеНаименование) > МетаданныеНоменклатуры.ДлинаНаименования Тогда
		ВызватьИсключение СтрШаблон("Текст длиннее %1 символов (%2): ""%3""",
			МетаданныеНоменклатуры.ДлинаНаименования, СтрДлина(НовоеНаименование), НовоеНаименование);
	КонецЕсли;

	Результат = Новый Структура("Переименовано, Пропущено", 0, Новый Массив);
	Изменения = Новый Массив;

	НачатьТранзакцию();
	Попытка

		Для Каждого Ссылка Из Ссылки Цикл

			Если ТипЗнч(Ссылка) <> Тип("СправочникСсылка.Номенклатура") Тогда
				Продолжить;
			КонецЕсли;

			ЗаблокироватьЭлемент(Ссылка);
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Если Объект.ЭтоГруппа Тогда
				Результат.Пропущено.Добавить(СтрШаблон("""%1"" - это группа, не переименована", Объект.Наименование));
				Продолжить;
			КонецЕсли;

			Если Объект.Наименование = НовоеНаименование
				И Объект.НаименованиеПолное = НовоеНаименование Тогда
				Продолжить;
			КонецЕсли;

			Изменения.Добавить(Новый Структура("Ссылка, Наименование, НаименованиеПолное, НовоеНаименование",
				Ссылка, Объект.Наименование, Объект.НаименованиеПолное, НовоеНаименование));

			Объект.Наименование = НовоеНаименование;
			Объект.НаименованиеПолное = НовоеНаименование;
			Объект.Записать();

		КонецЦикла;

		Если Изменения.Количество() > 0 Тогда
			История = ЗагрузитьИсторию();
			История.Добавить(Новый Структура("Дата, Изменения", ТекущаяДатаСеанса(), Изменения));
			Пока История.Количество() > ГлубинаИстории() Цикл
				История.Удалить(0);
			КонецЦикла;
			СохранитьИсторию(История);
		КонецЕсли;

		ЗафиксироватьТранзакцию();

	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Результат.Переименовано = Изменения.Количество();
	Возврат Результат;

КонецФункции

// Возвращает наименования последней операции к прежним значениям.
// Элемент, который после переименования успели изменить вручную, не трогается.
//
// Возвращаемое значение:
//   Структура - Восстановлено (Число), Пропущено (Массив строк), ИсторияПуста (Булево),
//               ОсталосьОпераций (Число).
//
Функция Откатить() Экспорт

	ПроверитьДоступ();

	Результат = Новый Структура("Восстановлено, Пропущено, ИсторияПуста, ОсталосьОпераций",
		0, Новый Массив, Ложь, 0);

	НачатьТранзакцию();
	Попытка

		История = ЗагрузитьИсторию();
		Если История.Количество() = 0 Тогда
			ОтменитьТранзакцию();
			Результат.ИсторияПуста = Истина;
			Возврат Результат;
		КонецЕсли;

		Операция = История[История.ВГраница()];

		Для Каждого Изменение Из Операция.Изменения Цикл

			ЗаблокироватьЭлемент(Изменение.Ссылка);
			Объект = Изменение.Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				Результат.Пропущено.Добавить(СтрШаблон("""%1"" - элемент удален", Изменение.Наименование));
				Продолжить;
			КонецЕсли;

			Если Объект.Наименование <> Изменение.НовоеНаименование Тогда
				Результат.Пропущено.Добавить(СтрШаблон("""%1"" - изменен после переименования, оставлен как есть",
					Объект.Наименование));
				Продолжить;
			КонецЕсли;

			Объект.Наименование = Изменение.Наименование;
			Объект.НаименованиеПолное = Изменение.НаименованиеПолное;
			Объект.Записать();
			Результат.Восстановлено = Результат.Восстановлено + 1;

		КонецЦикла;

		История.Удалить(История.ВГраница());
		СохранитьИсторию(История);

		ЗафиксироватьТранзакцию();

	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Результат.ОсталосьОпераций = История.Количество();
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КомандыДоступны()

	Пользователь = РазрешенныйПользователь();
	Если ЗначениеЗаполнено(Пользователь)
		И ВРег(ИмяПользователя()) <> ВРег(Пользователь)
		И ВРег(ПолноеИмяПользователя()) <> ВРег(Пользователь) Тогда
		Возврат Ложь;
	КонецЕсли;

	Компьютер = РазрешенныйКомпьютер();
	Если ЗначениеЗаполнено(Компьютер) Тогда
		// У пользователя без административных прав сеанс может быть недоступен.
		// Привилегированный режим работает только при снятом флажке "Безопасный режим" у расширения.
		Попытка
			УстановитьПривилегированныйРежим(Истина);
			ТекущийКомпьютер = ПолучитьТекущийСеансИнформационнойБазы().ИмяКомпьютера;
			УстановитьПривилегированныйРежим(Ложь);
		Исключение
			УстановитьПривилегированныйРежим(Ложь);
			Возврат Ложь;
		КонецПопытки;
		Если ВРег(ТекущийКомпьютер) <> ВРег(Компьютер) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;

КонецФункции

Процедура ПроверитьДоступ()

	Если Не КомандыДоступны() Тогда
		ВызватьИсключение "Массовое переименование недоступно для этого пользователя или компьютера.";
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьКоманду(Форма, Имя, Заголовок, СочетаниеКлавиш)

	Если Форма.Команды.Найти(Имя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Команда = Форма.Команды.Добавить(Имя);
	Команда.Заголовок = Заголовок;
	Команда.Действие = Имя;
	Команда.СочетаниеКлавиш = СочетаниеКлавиш;

	// Кнопка нужна, чтобы работало сочетание клавиш; прячем ее в меню "Еще".
	Кнопка = Форма.Элементы.Добавить(Имя, Тип("КнопкаФормы"), Форма.КоманднаяПанель);
	Кнопка.ИмяКоманды = Имя;
	Кнопка.ТолькоВоВсехДействиях = Истина;

КонецПроцедуры

Процедура ЗаблокироватьЭлемент(Ссылка)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.Номенклатура");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	Блокировка.Заблокировать();

КонецПроцедуры

// История хранится в настройках текущего пользователя в базе.
Функция ЗагрузитьИсторию()

	История = ХранилищеОбщихНастроек.Загрузить("МП_МассовоеПереименование", "История");
	Если ТипЗнч(История) <> Тип("Массив") Тогда
		История = Новый Массив;
	КонецЕсли;
	Возврат История;

КонецФункции

Процедура СохранитьИсторию(История)

	ХранилищеОбщихНастроек.Сохранить("МП_МассовоеПереименование", "История", История);

КонецПроцедуры

#КонецОбласти
